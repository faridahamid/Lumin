# Copy this file to .env locally and fill in your own keys.
# Never commit the real .env file.

OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TEXT_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=verse

MIDAS_MODEL_PATH=models/midas_v2_1_small.tflite
MIDAS_INPUT_SIZE=256
MIDAS_THREADS=4

PORT=3000
